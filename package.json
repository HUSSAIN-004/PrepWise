{
  "name": "prepwise-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "seed:admin": "npm --prefix server run seed:admin"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
